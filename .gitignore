# Public surface: 2.5D training, patch inference, examples and documentation.
# Other files remain local. Ignoring a file does not remove it from Git history.
/*
!/.gitignore
!/README.md
!/ATTRIBUTION.md
!/requirements.txt
!/LICENSE
!/NOTICE
!/train_accelerate_25d.py
!/loader_25d.py
!/inference_25d.py

!/models/
/models/*
!/models/__init__.py
!/models/network_25d.py
!/models/embeddings.py
!/models/swin_attention.py
!/models/swin_attention_3d.py
!/models/deformable_attention_3d.py

!/configs/
/configs/*
!/configs/train_25d.json
!/configs/smoke_25d.json
!/configs/showcase_25d.json

!/examples/
/examples/*
!/examples/__init__.py
!/examples/synthetic_demo.py
!/examples/README.md
!/examples/assets/
/examples/assets/*
!/examples/assets/synthetic_pipeline.png

!/tools/
/tools/*
!/tools/__init__.py
!/tools/summarize_runs_25d.py
!/tools/check_25d.py

!/docs/
/docs/*
!/docs/results.md
!/docs/run_summary.json
!/docs/run_scores.csv
!/docs/repository_audit.md
!/docs/validation.md
!/docs/showcase_provenance.json
!/docs/assets/
/docs/assets/*
!/docs/assets/run_comparison.png
!/docs/assets/synthrad_validation.png

# Defense in depth for data, secrets, checkpoints and generated files.
__pycache__/
*.py[cod]
*.bak
.env
.env.*
*.pem
*.key
*.nii
*.nii.gz
*.dcm
*.mha
*.mhd
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.pkl
*.npy
*.npz
*.h5
*.hdf5
events.out.tfevents.*
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/
